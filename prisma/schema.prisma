// Postgres (Neon, via le Vercel Marketplace). Prisma 7 refuse `url` et `directUrl` dans ce fichier :
// la CLI (db push, migrate) se connecte via prisma7.config.ts (POSTGRES_URL_NON_POOLING, connexion
// directe), l'application via lib/prisma.ts (POSTGRES_PRISMA_URL, connexion poolée).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Lead reçu d'un site de la flotte via POST /api/leads/inbound.
model Lead {
  id        String   @id @default(cuid())
  // ID du site émetteur, tel que défini dans lib/mock-data.json (ex. "elite-depannage-34").
  siteId    String
  name      String
  phone     String
  email     String?
  service   String
  source    String
  createdAt DateTime @default(now())

  // Comptages par site et par période (GET /api/leads).
  @@index([siteId, createdAt])
}

// Prospect démarché par e-mail (securium-prospector), importé par scripts/migrate-outreach.mts
// via POST /api/outreach/import. Distinct des leads entrants : absent des métriques des sites,
// jamais notifié sur Discord. Les désinscrits ne sont jamais importés (RGPD).
model OutreachProspect {
  id            String   @id @default(cuid())
  company       String
  // Adresse normalisée (minuscules) : un prospect par adresse, un réimport ne crée aucun doublon.
  email         String   @unique
  phone         String?
  // Dernier statut du registre de prospection : Envoye, Relance_1…
  status        String
  // Outil d'origine, ex. "securium-prospector".
  source        String
  // Premier contact, repris du registre : pas de valeur par défaut, l'historique fait foi.
  createdAt     DateTime
  // Dernière action du registre, relance comprise.
  lastContactAt DateTime
  // Entrée dans le Hub, pour la traçabilité.
  importedAt    DateTime @default(now())

  @@index([createdAt])
}
