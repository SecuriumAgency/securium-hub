// Postgres (Neon, via le Vercel Marketplace). Prisma 7 refuse `url` et `directUrl` dans ce fichier :
// la CLI (db push, migrate) se connecte via prisma7.config.ts (POSTGRES_URL_NON_POOLING, connexion
// directe), l'application via lib/prisma.ts (POSTGRES_PRISMA_URL, connexion poolée).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Lead reçu d'un site de la flotte via POST /api/leads/inbound.
model Lead {
  id        String   @id @default(cuid())
  // ID du site émetteur, tel que défini dans lib/mock-data.json (ex. "elite-depannage-34").
  siteId    String
  name      String
  phone     String
  email     String?
  service   String
  source    String
  createdAt DateTime @default(now())

  // Comptages par site et par période (GET /api/leads).
  @@index([siteId, createdAt])
}

// Prospect démarché par e-mail (securium-prospector), synchronisé par scripts/migrate-outreach.mts
// via POST /api/outreach/import. Distinct des leads entrants : absent des métriques des sites,
// jamais notifié sur Discord. Les désinscrits ne sont jamais importés, et sont supprimés s'ils se
// désinscrivent après coup (RGPD).
model OutreachProspect {
  id            String   @id @default(cuid())
  company       String
  // Adresse normalisée (minuscules) : un prospect par adresse, un réimport ne crée aucun doublon.
  email         String   @unique
  phone         String?
  // Dernier statut du registre de prospection : Envoye, Relance_1…
  status        String
  // Outil d'origine, ex. "securium-prospector".
  source        String
  // Premier contact, repris du registre : pas de valeur par défaut, l'historique fait foi.
  createdAt     DateTime
  // Dernière action du registre, relance comprise.
  lastContactAt DateTime
  // Entrée dans le Hub, pour la traçabilité.
  importedAt    DateTime @default(now())
  // Email rédigé par l'agent Chasseur, en attente de validation : au plus un à la fois.
  draft         OutreachDraft?

  @@index([createdAt])
}

// Email rédigé par l'agent Chasseur (scripts/agent-chasseur.mts), en attente de validation humaine
// sur /admin/outreach : rien ne part sans elle. Supprimé avec son prospect (purge RGPD), ou quand la
// synchronisation apporte un contact plus récent qui le rend obsolète.
model OutreachDraft {
  id             String           @id @default(cuid())
  prospectId     String           @unique
  prospect       OutreachProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  // Statut du prospect avant le brouillon, rétabli si le brouillon est rejeté.
  previousStatus String
  // Modèle Claude qui a rédigé le brouillon.
  model          String
  createdAt      DateTime         @default(now())
}
