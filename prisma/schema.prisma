// Postgres (Neon, via le Vercel Marketplace). Prisma 7 refuse `url` et `directUrl` dans ce fichier :
// la CLI (db push, migrate) se connecte via prisma7.config.ts (POSTGRES_URL_NON_POOLING, connexion
// directe), l'application via lib/prisma.ts (POSTGRES_PRISMA_URL, connexion poolée).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Lead reçu d'un site de la flotte via POST /api/leads/inbound.
model Lead {
  id        String   @id @default(cuid())
  // ID du site émetteur, tel que défini dans lib/mock-data.json (ex. "elite-depannage-34").
  siteId    String
  name      String
  phone     String
  email     String?
  service   String
  source    String
  createdAt DateTime @default(now())

  // Comptages par site et par période (GET /api/leads).
  @@index([siteId, createdAt])
}

// Colonnes du Kanban de prospection (/admin/outreach), libellées dans lib/kanban.ts.
enum PipelineStatus {
  NOUVEAU
  ICEBREAKER_GENERE
  EMAIL_1_ENVOYE
  RELANCE_1
  REPONDU
  REFUS
}

// Prospect démarché par e-mail (securium-prospector), synchronisé par scripts/migrate-outreach.mts
// via POST /api/outreach/import. Distinct des leads entrants : absent des métriques des sites,
// jamais notifié sur Discord. Les désinscrits ne sont jamais importés, et sont supprimés s'ils se
// désinscrivent après coup (RGPD).
model OutreachProspect {
  id             String            @id @default(cuid())
  company        String
  // Adresse normalisée (minuscules) : un prospect par adresse, un réimport ne crée aucun doublon.
  email          String            @unique
  phone          String?
  // Dernier statut du registre de prospection : Envoye, Relance_1…
  status         String
  // Colonne du Kanban, déplacée à la main : le registre et l'agent Chasseur gardent `status`, en texte libre.
  pipelineStatus PipelineStatus    @default(NOUVEAU)
  // Premier email ouvert, premier lien cliqué.
  emailOpenedAt  DateTime?
  linkClickedAt  DateTime?
  // Outil d'origine, ex. "securium-prospector".
  source         String
  // Premier contact, repris du registre : pas de valeur par défaut, l'historique fait foi.
  createdAt      DateTime
  // Dernière action du registre, relance comprise.
  lastContactAt  DateTime
  // Entrée dans le Hub, pour la traçabilité.
  importedAt     DateTime          @default(now())
  // Email rédigé par l'agent Chasseur, en attente de validation : au plus un à la fois.
  draft          OutreachDraft?
  // Échanges enregistrés par le Hub : emails envoyés à la validation, réponses lues en IMAP.
  messages       OutreachMessage[]
  // Journal des envois de la séquence.
  emailSequences EmailSequence[]

  @@index([createdAt])
}

// Envoi d'une séquence de prospection B2B, une ligne par email parti. Supprimé avec son prospect (purge RGPD).
model EmailSequence {
  id      String           @id @default(cuid())
  leadId  String
  lead    OutreachProspect @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject String
  body    String           @db.Text
  sentAt  DateTime         @default(now())
  // Rang dans la séquence : 1 pour le premier email, 2 pour la première relance…
  step    Int

  @@index([leadId, sentAt])
}

// Email échangé avec un prospect : OUTBOUND, envoyé par le Hub à la validation d'un brouillon (PATCH
// /api/outreach/drafts/[id]) ; INBOUND, réponse lue dans la boîte IMAP par scripts/agent-inbound.mts.
// Les emails antérieurs à la messagerie (registre du prospecteur) n'y figurent pas. Supprimé avec son
// prospect (purge RGPD).
model OutreachMessage {
  id         String           @id @default(cuid())
  prospectId String
  prospect   OutreachProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  // "INBOUND" ou "OUTBOUND".
  direction  String
  subject    String
  body       String           @db.Text
  // En-tête Message-ID de l'email : une réponse déjà enregistrée ne l'est pas deux fois.
  messageId  String?          @unique
  // Date de l'email (en-tête Date pour une réponse), maintenant à défaut.
  createdAt  DateTime         @default(now())

  @@index([prospectId, createdAt])
}

// Brief de l'agent Chasseur, saisi sur /admin/outreach (POST /api/outreach/settings) : une seule
// ligne, id « default ». L'agent le lit à chaque passage et refuse de rédiger sans lui.
model AgentSettings {
  id                 String   @id
  // Ce que l'agence vend.
  productDescription String
  // Le client idéal visé.
  targetAudience     String
  updatedAt          DateTime @updatedAt
}

// Email rédigé par l'agent Chasseur (scripts/agent-chasseur.mts), en attente de validation humaine
// sur /admin/outreach : rien ne part sans elle. Supprimé avec son prospect (purge RGPD), ou quand la
// synchronisation apporte un contact plus récent qui le rend obsolète.
model OutreachDraft {
  id             String           @id @default(cuid())
  prospectId     String           @unique
  prospect       OutreachProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  // Statut du prospect avant le brouillon, rétabli si le brouillon est rejeté.
  previousStatus String
  // Modèle Claude qui a rédigé le brouillon.
  model          String
  createdAt      DateTime         @default(now())
}

// Accroche rédigée par l'agent Chasseur (scripts/agent-chasseur-segments.mts) pour un segment de
// Securium-OS/data/leads/b2b-prospects.csv, écrit par le Lead Prospector : un email modèle, à adapter à
// une entreprise du segment. Le CSV n'a ni entreprise ni adresse : le Hub n'envoie jamais ce brouillon.
model ProspectionDraft {
  id         String   @id @default(cuid())
  // Segment, secteur et zone normalisés (lib/prospects-parser.ts) : un segment n'est rédigé qu'une fois.
  segmentKey String   @unique
  segment    String
  sector     String
  zone       String
  subject    String
  body       String
  // brouillon_en_attente à la rédaction.
  status     String
  // Modèle Claude qui a rédigé l'accroche.
  model      String
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}
