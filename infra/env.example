# Modèle pour infra/.env (compose) et pour les variables du Hub.
# Copier en .env, puis remplir. Ne jamais committer le fichier rempli (.env* est ignoré par git).
# Générer un secret : openssl rand -hex 32   (les mots de passe en hexadécimal évitent les soucis d'URL)

# --- Cloudflare Tunnel (Zero Trust) : seul point d'entrée public ---
# Token du tunnel : Zero Trust > Networks > Tunnels > (tunnel) > Configure, commande d'installation Docker.
# Routes déclarées dans l'onglet « Public Hostname » du tunnel, par exemple 360.securium-agency.fr -> HTTP securium-360-app:3000.
CLOUDFLARE_TUNNEL_TOKEN=""

# --- Compose : base de données partagée ---
POSTGRES_USER=securium
POSTGRES_PASSWORD=

# --- Securium 360 : application et base PostgreSQL lancées par ce compose ---
# Mot de passe de la base (openssl rand -hex 32 : en hexadécimal, il passe tel quel dans DATABASE_URL).
# Obligatoire. Il n'agit qu'à la création du volume D:/securium-data/postgres-360 : le changer ensuite ne modifie pas la base.
DB_360_PASSWORD=
# Adresse publique servie par le tunnel. Figée dans l'image au build et relue à l'exécution (domaine racine des vitrines).
SECURIUM_360_APP_URL=https://360.securium-agency.fr
# Dépôt securium-360, chemin relatif à infra/. Valeur par défaut : ../../securium-360.
# SECURIUM_360_PATH=../../securium-360
# Stripe, optionnel : sans clé, les routes de paiement répondent 503. La clé publique (pk_) est figée au build.
# Webhook à déclarer chez Stripe : https://360.securium-agency.fr/api/webhooks/stripe
SECURIUM_360_STRIPE_PUBLISHABLE_KEY=
SECURIUM_360_STRIPE_SECRET_KEY=
SECURIUM_360_STRIPE_WEBHOOK_SECRET=
SECURIUM_360_STRIPE_PRICE_SUBSCRIPTION=
SECURIUM_360_STRIPE_PRICE_SETUP_FEE=
# Webhook Discord des visites de démo, optionnel : sans lui, /api/track-demo répond 503.
SECURIUM_360_DISCORD_TRACKER_WEBHOOK=

# --- Compose : Chatwoot ---
CHATWOOT_IMAGE=chatwoot/chatwoot:latest
CHATWOOT_SECRET_KEY_BASE=
# Adresse publique du tunnel (hostname Cloudflare de Chatwoot) : elle figure dans les liens des e-mails.
CHATWOOT_FRONTEND_URL=http://127.0.0.1:3102

# --- Compose : Cal.com ---
CALCOM_IMAGE=calcom/cal.com:latest
# Adresse publique du tunnel (hostname Cloudflare de Cal.com) : Cal.com en génère les liens.
CALCOM_WEBAPP_URL=http://127.0.0.1:3101
CALCOM_NEXTAUTH_SECRET=
CALCOM_ENCRYPTION_KEY=

# --- Compose : OpenProject, Ollama, WeKnora ---
OPENPROJECT_SECRET_KEY_BASE=
OPENPROJECT_HOST_NAME=127.0.0.1:3103
OLLAMA_IMAGE=ollama/ollama:latest
# WeKnora désactivé : image non publique. Décommenter avec le bloc weknora du compose.
# WEKNORA_IMAGE=

# --- Compose : VoiceStudio (OmniVoice) et WeKnora : requises par le compose, sans elles docker compose refuse de démarrer ---
# Clé d'API de VoiceStudio (OmniVoice), serveur seulement. Générer : openssl rand -hex 32
OMNIVOICE_API_KEY=
# WeKnora : base PostgreSQL dédiée. L'utilisateur et le nom de base ne sont pas secrets ; le mot de passe l'est.
WEKNORA_DB_USER=weknora
WEKNORA_DB_PASSWORD=
WEKNORA_DB_NAME=weknora
# WeKnora : secret de signature des jetons, et mot de passe de Redis. Générer : openssl rand -hex 32
WEKNORA_JWT_SECRET=
WEKNORA_REDIS_PASSWORD=

# --- Compose : Open-SEO et Cap (secrets : openssl rand -hex 32) ---
OPEN_SEO_AUTH_SECRET=
# Hostname public de Open-SEO, sans https:// (sert à ALLOWED_HOST).
OPEN_SEO_HOST=seo.securium-agency.fr
# Clé DataForSEO, payante, fournie par l'utilisateur. Peut aussi se saisir dans Open-SEO.
DATAFORSEO_API_KEY=
CAP_MYSQL_PASSWORD=
CAP_MYSQL_ROOT_PASSWORD=
CAP_MINIO_ROOT_USER=cap-admin
CAP_MINIO_ROOT_PASSWORD=
CAP_DATABASE_ENCRYPTION_KEY=
CAP_NEXTAUTH_SECRET=
CAP_MEDIA_SERVER_WEBHOOK_SECRET=
# Adresse publique du stockage S3 de Cap : les navigateurs y téléchargent les vidéos.
CAP_S3_PUBLIC_URL=

# --- Cloudflare Access : jeton de service pour joindre les modules (serveur seulement, jamais dans le navigateur) ---
# Créer le jeton dans Zero Trust > Access > Service Auth, puis une règle « Service Auth » sur chaque hostname.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Hub (.env.local et Vercel) : adresses des modules ---
# *_URL : adresse que le serveur du Hub appelle (jamais exposée au navigateur).
# *_PUBLIC_URL : adresse ouverte par le bouton « Ouvrir » de /admin/ecosystem.
# Hostnames publics du tunnel, en https : le Hub les joint à travers Cloudflare Access (voir ci-dessus).
# Aucun module ne publie de port, donc une adresse 127.0.0.1 ne répond pas.
CALCOM_URL=
CALCOM_PUBLIC_URL=
CALCOM_API_KEY=
CHATWOOT_URL=
CHATWOOT_PUBLIC_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
OPEN_SEO_URL=
OPEN_SEO_PUBLIC_URL=
OPEN_SEO_API_TOKEN=
VOICE_STUDIO_URL=
VOICE_STUDIO_PUBLIC_URL=
VOICE_STUDIO_API_KEY=
WEKNORA_URL=
WEKNORA_PUBLIC_URL=
OPENPROJECT_URL=
OPENPROJECT_PUBLIC_URL=
OPEN_HIGGSFIELD_URL=
OPEN_HIGGSFIELD_PUBLIC_URL=
OPENWHISPR_URL=
OPENWHISPR_PUBLIC_URL=
CAP_URL=
CAP_PUBLIC_URL=
# --- Open-SEO (optionnel) : Google Search Console/Analytics et fonctions IA ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=
