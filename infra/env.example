# Modèle pour infra/.env (compose) et pour les variables du Hub.
# Copier en .env, puis remplir. Ne jamais committer le fichier rempli (.env* est ignoré par git).
# Générer un secret : openssl rand -hex 32   (les mots de passe en hexadécimal évitent les soucis d'URL)

# --- Compose : base de données partagée ---
POSTGRES_USER=securium
POSTGRES_PASSWORD=

# --- Compose : Chatwoot ---
CHATWOOT_IMAGE=chatwoot/chatwoot:latest
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_PORT=3102
CHATWOOT_FRONTEND_URL=http://127.0.0.1:3102

# --- Compose : Cal.com ---
CALCOM_IMAGE=calcom/cal.com:latest
CALCOM_PORT=3101
CALCOM_WEBAPP_URL=http://127.0.0.1:3101
CALCOM_NEXTAUTH_SECRET=
CALCOM_ENCRYPTION_KEY=

# --- Compose : OpenProject, Ollama, WeKnora ---
OPENPROJECT_IMAGE=openproject/community:14
OPENPROJECT_SECRET_KEY_BASE=
OPENPROJECT_HOST_NAME=127.0.0.1:3103
OLLAMA_IMAGE=ollama/ollama:latest
WEKNORA_IMAGE=

# --- Hub (.env.local et Vercel) : adresses des modules ---
# *_URL : adresse que le serveur du Hub appelle (jamais exposée au navigateur).
# *_PUBLIC_URL : adresse ouverte par le bouton « Ouvrir » de /admin/ecosystem.
CALCOM_URL=http://127.0.0.1:3101
CALCOM_PUBLIC_URL=http://127.0.0.1:3101
CALCOM_API_KEY=
CHATWOOT_URL=http://127.0.0.1:3102
CHATWOOT_PUBLIC_URL=http://127.0.0.1:3102
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
OPEN_SEO_URL=
OPEN_SEO_PUBLIC_URL=
OPEN_SEO_API_TOKEN=
VOICE_STUDIO_URL=
VOICE_STUDIO_PUBLIC_URL=
VOICE_STUDIO_API_KEY=
WEKNORA_URL=
WEKNORA_PUBLIC_URL=
OPENPROJECT_URL=
OPENPROJECT_PUBLIC_URL=
OPEN_HIGGSFIELD_URL=
OPEN_HIGGSFIELD_PUBLIC_URL=
OPENWHISPR_URL=
OPENWHISPR_PUBLIC_URL=
CAP_URL=
CAP_PUBLIC_URL=
