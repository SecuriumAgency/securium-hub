# Modèle de configuration du Securium Hub pour les modules de l'écosystème.
# Copier en .env.local pour le développement, ou renseigner les mêmes noms dans les variables d'environnement de Vercel.
# Ne jamais committer le fichier rempli : seul ce modèle est suivi par git.

# --- Modules : adresses publiques en https, reliées par Cloudflare Tunnel ---
# *_URL : adresse que le serveur du Hub appelle. *_PUBLIC_URL : adresse ouverte par le bouton « Ouvrir ».
# Aucune adresse locale : chaque module est joint par son hostname public, protégé par Cloudflare Access.
CALCOM_URL="https://cal.securium-agency.fr"
CALCOM_PUBLIC_URL="https://cal.securium-agency.fr"
CALCOM_API_KEY=""
CHATWOOT_URL="https://crm.securium-agency.fr"
CHATWOOT_PUBLIC_URL="https://crm.securium-agency.fr"
CHATWOOT_ACCOUNT_ID=""
CHATWOOT_API_TOKEN=""
OPEN_SEO_URL=""
OPEN_SEO_PUBLIC_URL=""
OPEN_SEO_API_TOKEN=""
VOICE_STUDIO_URL=""
VOICE_STUDIO_PUBLIC_URL=""
VOICE_STUDIO_API_KEY=""
WEKNORA_URL=""
WEKNORA_PUBLIC_URL=""
OPENPROJECT_URL=""
OPENPROJECT_PUBLIC_URL=""
OPEN_HIGGSFIELD_URL=""
OPEN_HIGGSFIELD_PUBLIC_URL=""
OPENWHISPR_URL=""
OPENWHISPR_PUBLIC_URL=""
CAP_URL=""
CAP_PUBLIC_URL=""

# --- Génération d'images on-premise (nœud IA local, Docker) : appelée par le serveur du Hub uniquement ---
# Adresse locale, jamais exposée au navigateur : pas de préfixe NEXT_PUBLIC_. Le nœud n'est joignable que depuis cette machine.
LOCAL_IMAGE_GEN_URL="http://127.0.0.1:7860"

# --- Cloudflare Access : jeton de service (M2M) ---
# Ajouté à chaque appel sortant vers un module en https. Sans ces deux valeurs, aucun en-tête n'est envoyé.
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""
# --- Widget Chatwoot (token de site, public par conception) ---
NEXT_PUBLIC_CHATWOOT_BASE_URL="https://crm.securium-agency.fr"
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN="HhywB6v76j6vM5WeScK8XRVD"
# --- Prospection : statut des runs de securium-prospector (lecture seule, panneau Prospection > Suivi) ---
# Token GitHub avec l'accès « Actions : lecture » sur SecuriumAgency/securium-prospector. Vide = panneau désactivé.
PROSPECTOR_GITHUB_TOKEN=""
